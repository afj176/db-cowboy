<Application x:Class="DbCowboy.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">

<SolidColorBrush x:Key="AccentButtonBackground" Color="#A64F22"/><SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#A64F22"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#A64F22"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#A64F22"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#A64F22"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="#A64F22"/><SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#99481F"/><SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#873F1B"/><SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/><SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/><SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/><SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF"/>
     <Color x:Key="SystemAccentColor">#A64F22</Color>
     <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#A64F22"/>
     <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#99481F"/>
     <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#873F1B"/>
     <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#A64F22"/>
     <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">

<SolidColorBrush x:Key="AccentButtonBackground" Color="#F1BC77"/><SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#F1BC77"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#F1BC77"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#F1BC77"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#F1BC77"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="#F1BC77"/><SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E4B06C"/><SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D4A05F"/><SolidColorBrush x:Key="AccentButtonForeground" Color="#101B21"/><SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#101B21"/><SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#101B21"/><SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#101B21"/>
     <Color x:Key="SystemAccentColor">#F1BC77</Color>
     <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F1BC77"/>
     <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E4B06C"/>
     <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D4A05F"/>
     <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F1BC77"/>
     <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#101B21"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"/>
   </ResourceDictionary.ThemeDictionaries>
<Style TargetType="TabView"><Setter Property="Background" Value="{ThemeResource TabViewBackground}"/></Style>
<Style TargetType="TabViewItem"><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderThickness" Value="0"/></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>

